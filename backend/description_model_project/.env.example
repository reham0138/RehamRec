# Copy this file to .env and adjust as needed. .env is git-ignored.

# Path to the dataset CSV (must have columns: song, artist, translated_genres, text, full_description)
DATA_CSV_PATH=data/songs_with_descriptions_V3.csv

# Directory containing song_embeddings_1.npy and song_embeddings_2.npy
EMBEDDINGS_DIR=models

# Must match the SentenceTransformer model the embeddings were built with
MODEL_NAME=all-MiniLM-L6-v2

# Timeout (seconds) for requests to the iTunes Search API
MUSIC_API_TIMEOUT=5

# Comma-separated list of origins allowed to call the API (CORS)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# The iTunes Search API used by src/inference/music_api.py requires no API
# key. This variable is kept only in case you later swap in a different
# music API that does require one.
# MUSIC_API_KEY=your_api_key_here
